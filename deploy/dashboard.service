[Unit]
Description=Trading bot read-only dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading-bot
ExecStart=/root/trading-bot/.venv/bin/python3 -m app.dashboard_server
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=DASHBOARD_PORT=8080

# This service never needs to write anything -- it only reads live_state.db
# (opened read-only at the SQLite level in dashboard_server.py) and serves static
# files that ship with the repo. No ReadWritePaths granted at all.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
