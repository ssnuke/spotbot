[Unit]
Description=Trading bot heartbeat watchdog (dead-man's switch)
# Deliberately does NOT declare After=trading-bot.service or any dependency on it -- this
# unit must keep running on its own timer even if trading-bot.service has crashed and its
# own Restart= has given up entirely.

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/trading-bot
ExecStart=/root/trading-bot/.venv/bin/python3 scripts/heartbeat_watchdog.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/trading-bot
