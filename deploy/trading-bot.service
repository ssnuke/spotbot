[Unit]
Description=BTC/USDT paper trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
WorkingDirectory=/home/botuser/trading-bot
# -u disables stdout buffering -- without it, Python fully block-buffers stdout when it's
# not a TTY (i.e. always, under systemd), so print() output (including order-failure logs)
# can sit invisible in the buffer for a long time instead of reaching journalctl promptly.
ExecStart=/home/botuser/trading-bot/.venv/bin/python3 -u main.py --mode bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Basic sandboxing: the service can only write inside its own working directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/botuser/trading-bot

[Install]
WantedBy=multi-user.target
